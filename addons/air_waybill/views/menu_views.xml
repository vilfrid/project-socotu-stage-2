<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action -->
    <record id="action_air_waybill" model="ir.actions.act_window">
        <field name="name">Air Waybills</field>
        <field name="res_model">air.waybill</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_air_waybill_list"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Air Waybill!
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_air_waybill_root" name="Air Waybills" sequence="10"/>
    <menuitem id="menu_air_waybill_main" parent="menu_air_waybill_root"
        action="action_air_waybill" name="Air Waybills" sequence="1"/>
</odoo>
