<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_air_waybill_list" model="ir.ui.view">
        <field name="name">air.waybill.list</field>
        <field name="model">air.waybill</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list string="Air Waybill">
                <field name="name"/>
                <field name="date"/>
                <field name="shipper_id"/>
                <field name="consignee_id"/>
                <field name="gross_weight"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_air_waybill_form" model="ir.ui.view">
        <field name="name">air.waybill.form</field>
        <field name="model">air.waybill</field>
        <field name="arch" type="xml">
            <form string="Air Waybill">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="LTA Number"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="shipper_id"/>
                            <field name="shipper_address"/>
                            <field name="consignee_id"/>
                            <field name="consignee_address"/>
                        </group>
                        <group>
                            <field name="flight_number"/>
                            <field name="departure"/>
                            <field name="destination"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Cargo Information">
                            <group>
                                <group>
                                    <field name="gross_weight"/>
                                    <field name="chargeable_weight"/>
                                    <field name="pieces"/>
                                </group>
                                <group>
                                    <field name="purchase_amount"/>
                                    <field name="sale_amount"/>
                                </group>
                            </group>
                            <group string="Additional Information">
                                <field name="handling_info"/>
                                <field name="description"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_air_waybill_search" model="ir.ui.view">
        <field name="name">air.waybill.search</field>
        <field name="model">air.waybill</field>
        <field name="arch" type="xml">
            <search string="Search Air Waybill">
                <field name="name"/>
                <field name="shipper_id"/>
                <field name="consignee_id"/>
                <field name="flight_number"/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="In Transit" name="in_transit" domain="[('state','=','in_transit')]"/>
                <filter string="Delivered" name="delivered" domain="[('state','=','delivered')]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_air_waybill" model="ir.actions.act_window">
        <field name="name">Air Waybills</field>
        <field name="res_model">air.waybill</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_air_waybill_list"/>
    </record>

    <!-- Menu -->
    <menuitem id="menu_air_waybill_root" name="Air Waybill"/>
    <menuitem id="menu_air_waybill" parent="menu_air_waybill_root" action="action_air_waybill" name="Air Waybills"/>
</odoo>
