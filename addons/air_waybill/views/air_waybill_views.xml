<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List view -->
    <record id="view_air_waybill_list" model="ir.ui.view">
        <field name="name">air.waybill.list</field>
        <field name="model">air.waybill</field>
        <field name="arch" type="xml">
            <list string="Air Waybill">
                <field name="name"/>
                <field name="date"/>
                <field name="shipper_id"/>
                <field name="consignee_id"/>
                <field name="gross_weight"/>
                <field name="volume"/>
                <field name="iata_code"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_air_waybill_form" model="ir.ui.view">
        <field name="name">air.waybill.form</field>
        <field name="model">air.waybill</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Air Waybill">
                <header>
                    <field name="state" widget="statusbar"/>
                    <button name="action_toggle_column_2"
                            type="object"
                            string="LTA Soustraite"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="date"/>
                            <field name="shipper_id"/>
                            <field name="shipper_address"/>
                            <field name="consignee_id"/>
                            <field name="consignee_address"/>
                        </group>
                        <group>
                            <field name="flight_number"/>
                            <field name="departure"/>
                            <field name="destination"/>
                            <field name="currency_id"/>
                            <field name="iata_code"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Cargo Information">
                            <group>
                                <field name="gross_weight"/>
                                <field name="chargeable_weight"/>
                                <field name="pieces"/>
                                <field name="length"/>
                                <field name="width"/>
                                <field name="height"/>
                                <field name="volume" readonly="1"/>
                                <field name="handling_info"/>
                            </group>
                        </page>
                        <page string="Financial &amp; Additional Info">
                            <group>
                                <field name="purchase_amount"/>
                                <field name="sale_amount"/>
                                <field name="description"/>
                            </group>
                            <group>
                                <field name="financial_line_ids">
                                    <list editable="bottom">
                                        <field name="column_1"/>
                                        <field name="column_2" attrs="{'invisible':[('hide_column_2','=',True)]}"/>

                                        <field name="column_3"/>
                                        <field name="column_4"/>
                                        <field name="column_5"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Assets -->

</odoo>
