<odoo>
    <record id="view_order_form_airwaybill" model="ir.ui.view">
        <field name="name">sale.order.form.airwaybill</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Air Waybills">
                    <field name="airwaybill_ids">
                        <tree editable="bottom">
                            <field name="airwaybill_number"/>
                            <field name="shipper"/>
                            <field name="consignee"/>
                            <field name="airline"/>
                            <field name="departure"/>
                            <field name="arrival"/>
                            <field name="flight_no"/>
                            <field name="flight_date"/>
                            <field name="gross_weight"/>
                            <field name="chargeable_weight"/>
                            <field name="freight_amount"/>
                            <field name="currency_id"/>
                            <field name="cargo_status"/>
                        </tree>
                        <form>
                            <group>
                                <field name="airwaybill_number"/>
                                <field name="shipper"/>
                                <field name="consignee"/>
                                <field name="airline"/>
                            </group>
                            <group>
                                <field name="departure"/>
                                <field name="arrival"/>
                                <field name="flight_no"/>
                                <field name="flight_date"/>
                            </group>
                            <group>
                                <field name="gross_weight"/>
                                <field name="chargeable_weight"/>
                                <field name="freight_amount"/>
                                <field name="currency_id"/>
                            </group>
                            <group>
                                <field name="cargo_status"/>
                            </group>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
